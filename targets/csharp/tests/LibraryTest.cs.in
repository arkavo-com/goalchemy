 static WeakReference SourceRoot()
 {
  Frame frame=R.sched.cur.frame;while(frame!=null){var value=SourceIn(frame,true);if(value!=null)return new WeakReference(value);frame=frame.parent;}throw new Exception("actual source root not found");
