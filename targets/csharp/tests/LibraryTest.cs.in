  try
  {
   var options=Providers(new Callback.Registration("ready",r=>{r.Retain();_=Task.Run(()=>{Check(started.Wait(10000),"actual native sign acquired");r.Resolve(Array.Empty<byte>());});}),new Callback.Registration("closed",r=>{Check(started.IsSet&&!release.IsSet,"alias closed while native key acquired");release.Set();r.Resolve(Array.Empty<byte>());}));
   Check(Await(Generated.KeyRace(options)).SequenceEqual(new byte[]{1,2,255}),"real native alias Close preserves acquired work");
